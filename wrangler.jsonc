{
  "name": "electricity-meter-tracker",
  "compatibility_date": "2026-09-08",
  "main": "./src/worker.ts",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*"]
  }

  // Canonical remote D1 binding is intentionally absent until the real
  // `electricity-meter-tracker` database has been created. Do not commit a
  // placeholder/fake database_id. Once created, bind it here as `DB` and keep
  // local synthetic fixtures on wrangler.local.jsonc only.
}
